
meta {
	title: "Open Infrastructure Map";
	description: "Render power lines with the Open Infrastructure Map colour scheme";
	version: "0.0.4";
	author: "russss";
}

/* Supports */
way["power"="portal"]{
	width:2;
	color:#FFFFFF;
}

way[power="portal"] node{
	symbol-shape:triangle;
	symbol-size:10;
	symbol-fill-color:#EDEDED;
}

/* Power Lines */

way[power=~/line|minor_line|cable/],
 way[construction:power=~/line|minor_line|cable/]{
	set power_line;
	text: cables;
	font-size: 16px;
	text-halo-radius: 2;
} 

way[power=cable], way[construction:power=cable]{
	dashes:2,2;
}

way[construction:power=~/line|minor_line|cable/] {
	casing-dashes:2,2;
	casing-width:2;
	casing-color:#FFF635;
	casing-opacity:0.5;
}

way[power=line][line=busbar]{
	casing-color:#FFD800;
	casing-width:1;
	width:3;
}

way[power=line][line=bay]{
	casing-color:#A0A0A0;
	casing-width:2;
	width:3;
}

/* Line Voltages */
way.power_line[to_int(get(split(";",tag(voltage)),0))<10000]{
	width:1;
	color:#7A7A85;
	text-halo-color:#7A7A85;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=10000][to_int(get(split(";",tag(voltage)),0))<40000]{
	width:1;
	color:#6E97B8;
	text-halo-color:#6E97B8;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=40000][to_int(get(split(";",tag(voltage)),0))<100000]{
	width:2;
	color:#55B555;
	text-halo-color:#55B555;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=100000][to_int(get(split(";",tag(voltage)),0))<200000]{
	width:2;
	color:#B59F10;
	text-halo-color:#B59F10;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=200000][to_int(get(split(";",tag(voltage)),0))<300000]{
	width:3;
	color:#B55D00;
	text-halo-color:#B55D00;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=300000][to_int(get(split(";",tag(voltage)),0))<500000]{
	width:4;
	color:#C73030;
	text-halo-color:#C73030;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=500000][to_int(get(split(";",tag(voltage)),0))<600000]{
	width:5;
	color:#B54EB2;
	text-halo-color:#B54EB2;
}
way.power_line[to_int(get(split(";",tag(voltage)),0))>=600000]{
	width:5;
	color:#00C1CF;
	text-halo-color:#00C1CF;
}

way.power_line[to_int(get(split(";",tag(frequency)),0))=0]{
	color:#4E01B5;
}

way.power_line[to_float(get(split(";",tag(frequency)),0))>16][to_float(get(split(";",tag(frequency)),0))<17]{
	color:#A8B596;
}

way.power_line[circuits>1]{
	left-casing-dashes:2,14;
	left-casing-width:5;
}

way.power_line[circuits>2]{
	right-casing-dashes:2,14;
	right-casing-width:5;
}

/* Second circuit voltages */
way.power_line[to_int(get(split(";",tag(voltage)),1))<10000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage<10000]{
	left-casing-color:#7A7A85;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=10000][to_int(get(split(";",tag(voltage)),1))<50000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=10000][voltage<50000]{
	left-casing-color:#6E97B8;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=50000][to_int(get(split(";",tag(voltage)),1))<100000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=50000][voltage<100000]{
	left-casing-color:#55B555;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=100000][to_int(get(split(";",tag(voltage)),1))<200000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=100000][voltage<200000]{
	left-casing-color:#B59F10;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=200000][to_int(get(split(";",tag(voltage)),1))<300000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=200000][voltage<300000]{
	left-casing-color:#B55D00;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=300000][to_int(get(split(";",tag(voltage)),1))<500000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=300000][voltage<500000]{
	left-casing-color:#C73030;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=500000][to_int(get(split(";",tag(voltage)),1))<600000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=500000][voltage<600000]{
	left-casing-color:#B54EB2;
}
way.power_line[to_int(get(split(";",tag(voltage)),1))>=600000],
way.power_line[circuits>1][count(split(";",tag(voltage)))=1][voltage>=600000]{
	left-casing-color:#00C1CF;
}

way.power_line[to_int(get(split(";",tag(frequency)),1))=0],
way.power_line[circuits>1][count(split(";",tag(frequency)))=1][frequency=0]{
	left-casing-color:#4E01B5;
}

way.power_line[to_float(get(split(";",tag(frequency)),1))>16][to_float(get(split(";",tag(frequency)),1))<17],
way.power_line[circuits>1][count(split(";",tag(frequency)))=1][frequency>16][frequency<17] {
	left-casing-color:#A8B596;
}


/* Third circuit voltages */
way.power_line[to_int(get(split(";",tag(voltage)),2))<10000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage<10000]{
	right-casing-color:#7A7A85;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=10000][to_int(get(split(";",tag(voltage)),2))<50000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=10000][voltage<50000]{
	right-casing-color:#6E97B8;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=50000][to_int(get(split(";",tag(voltage)),2))<100000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=50000][voltage<100000]{
	right-casing-color:#55B555;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=100000][to_int(get(split(";",tag(voltage)),2))<200000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=100000][voltage<200000]{
	right-casing-color:#B59F10;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=200000][to_int(get(split(";",tag(voltage)),2))<300000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=200000][voltage<300000]{
	right-casing-color:#B55D00;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=300000][to_int(get(split(";",tag(voltage)),2))<500000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=300000][voltage<500000]{
	right-casing-color:#C73030;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=500000][to_int(get(split(";",tag(voltage)),2))<600000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=500000][voltage<600000]{
	right-casing-color:#B54EB2;
}
way.power_line[to_int(get(split(";",tag(voltage)),2))>=600000],
way.power_line[circuits>2][count(split(";",tag(voltage)))=1][voltage>=600000]{
	right-casing-color:#00C1CF;
}

way.power_line[to_int(get(split(";",tag(frequency)),2))=0],
way.power_line[circuits>2][count(split(";",tag(frequency)))=1][frequency=0]{
	right-casing-color:#4E01B5;
}

way.power_line[to_float(get(split(";",tag(frequency)),2))>16][to_float(get(split(";",tag(frequency)),2))<17],
way.power_line[circuits>2][count(split(";",tag(frequency)))=1][frequency>16][frequency<17] {
	right-casing-color:#A8B596;
}


/* Substation colours */
area[power=substation]{
	fill-opacity:0.6;
	fill-extent:10;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))<10000]{
	fill-color:#7A7A85;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=10000][to_int(get(split(";",tag(voltage)),0))<50000]{
	fill-color:#6E97B8;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=50000][to_int(get(split(";",tag(voltage)),0))<100000]{
	fill-color:#55B555;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=100000][to_int(get(split(";",tag(voltage)),0))<200000]{
	fill-color:#B59F10;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=200000][to_int(get(split(";",tag(voltage)),0))<300000]{
	fill-color:#B55D00;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=300000][to_int(get(split(";",tag(voltage)),0))<500000]{
	fill-color:#C73030;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=500000][to_int(get(split(";",tag(voltage)),0))<600000]{
	fill-color:#B54EB2;
}

area[power=substation][to_int(get(split(";",tag(voltage)),0))>=600000]{
	fill-color:#00C1CF;
}

area[power=substation][to_int(get(split(";",tag(frequency)),0))=0]{
	fill-color:#4E01B5;
}

area[power=substation][to_float(get(split(";",tag(frequency)),0))>16][to_float(get(split(";",tag(frequency)),0))<17]{
	fill-color:#A8B596;
}